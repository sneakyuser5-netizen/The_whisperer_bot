# The Whisperer Bot - environment variables
# Replace the placeholder values with your real API keys/tokens.
# Do NOT commit this file to source control. Add .env to .gitignore.

# NEWS_API_KEY
# - Used to fetch news headlines/data.
# - Obtain from NewsAPI (https://newsapi.org/) or your chosen news provider.
# - Example: NEWS_API_KEY=abc123DEF456ghi789

NEWS_API_KEY=your_newsapi_key_here

# TMDB_API_KEY
# - Used to query The Movie Database (TMDB) for movie/TV info.
# - Get a key at https://www.themoviedb.org/settings/api
# - Example: TMDB_API_KEY=abcd1234efgh5678

TMDB_API_KEY=your_tmdb_api_key_here

# GROQ_API_KEY
# - A Sanity/GROQ API token used for querying your Sanity dataset (if your app uses Sanity).
# - Create a read (or read/write if needed) token in your Sanity project settings: https://www.sanity.io/
# - Example: GROQ_API_KEY=sk_test_XXXXXXXXXXXXXXXX

GROQ_API_KEY=your_groq_api_key_here

# Optional Sanity identifiers (if using GROQ + Sanity)
# - Project ID and dataset help build the Sanity API URL.
# - Example: SANITY_PROJECT_ID=abcd1234 SANITY_DATASET=production
SANITY_PROJECT_ID=your_sanity_project_id_here
SANITY_DATASET=production

# Environment / runtime settings
# - NODE_ENV can control behavior in dev/production.
# - PORT used by local dev server
NODE_ENV=development
PORT=3000
